# EFMIS API — production environment template. Copy to .env on the server, fill every <...>, keep it out of git.
# The API refuses to start in production when JWT_SECRET is weak, DEMO_MODE or DB_SEED_ON_START is on,
# TRACCAR_WEBHOOK_SECRET is missing, or CORS_ORIGINS contains '*'.

NODE_ENV=production
PORT=4000
# Exact public origin(s) of the web frontend
CORS_ORIGINS=https://<efmis-portal-domain>

# ---- PostgreSQL (private network only) ----
DB_HOST=<postgres-host>
DB_PORT=5432
DB_USERNAME=efmis
DB_PASSWORD=<strong-random-password>
DB_NAME=efmis
DB_MIGRATIONS_RUN=true
DB_SEED_ON_START=false

# ---- Auth ----
# 48+ random bytes, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=<random-secret>
JWT_EXPIRES_IN=8h
SESSION_IDLE_MINUTES=15
DEMO_MODE=false

# ---- Files (mount persistent, backed-up volumes) ----
UPLOAD_DIR=/app/uploads
PROOF_STORAGE_DIR=/app/storage/private
MAX_UPLOAD_MB=5

# ---- Workflow ----
SCHEDULER_ENABLED=true
KEBELE_ESCALATION_DAYS=7

# ---- Redis (queues, GPS hot state, login lockout across instances) ----
REDIS_URL=redis://<redis-host>:6379

# ---- National integrations (empty = adapter disabled / mock) ----
FAYDA_API_URL=<fayda-endpoint>
FAYDA_SIMULATE_OUTAGE=false
NRLAIS_API_URL=<nrlais-endpoint>
NSIS_API_URL=<nsis-endpoint>
EABC_API_URL=<eabc-endpoint>
USSD_GATEWAY_KEY=<ussd-gateway-key>

# ---- GPS Tracking Platform (Traccar) ----
# Traccar forwards positions/events to /api/v1/integrations/traccar/{positions,events} with this header secret
TRACCAR_WEBHOOK_SECRET=<random-secret>
# Read-only Traccar service account used to poll as a safety net
TRACCAR_URL=http://<traccar-host>:8082
TRACCAR_USER=efmis.integration@<domain>
TRACCAR_PASSWORD=<service-account-password>
TRACCAR_POLL_SECONDS=30
# Where Traccar reaches the API (docker-compose); in compose with the api service: http://api:4000
TRACCAR_FORWARD_TARGET=http://api:4000

# ---- Road routing provider (OSRM-compatible /route/v1/driving). Empty = straight-line × road factor ----
ROUTING_PROVIDER_URL=<osrm-endpoint>
