# ---- Server ----
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000

# ---- PostgreSQL (docker compose up -d postgres) ----
DB_HOST=localhost
DB_PORT=55433
DB_USERNAME=efmis
DB_PASSWORD=efmis_dev_password
DB_NAME=efmis
# Run pending migrations automatically on startup
DB_MIGRATIONS_RUN=true
# Seed demo/master data when the database is empty
DB_SEED_ON_START=true

# ---- Auth ----
JWT_SECRET=change-me-efmis-dev-secret
JWT_EXPIRES_IN=8h
SESSION_IDLE_MINUTES=15
# Demo mode: 1-click persona login + OTP returned in responses (no SMS gateway). MUST be false in production.
DEMO_MODE=true

# ---- Uploads (REQ-1.1-002) ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# ---- Workflow ----
SCHEDULER_ENABLED=true
KEBELE_ESCALATION_DAYS=7

# ---- External integrations (mock adapters used when empty) ----
FAYDA_API_URL=
FAYDA_SIMULATE_OUTAGE=false
NRLAIS_API_URL=
NSIS_API_URL=
EABC_API_URL=
USSD_GATEWAY_KEY=

# ---- Redis (queues + hot GPS state). Empty = in-process fallback (jobs run inline, cache in memory) ----
REDIS_URL=redis://localhost:56379

# ---- Logistics: GPS Tracking Platform (Traccar) ----
# Base URL of the GPS Tracking Platform REST API (empty = adapter disabled; use webhook / simulator)
TRACCAR_URL=
TRACCAR_USER=
TRACCAR_PASSWORD=
# Shared secret Traccar sends in X-Traccar-Secret when forwarding positions to /api/v1/integrations/traccar/positions
TRACCAR_WEBHOOK_SECRET=change-me-traccar-secret
TRACCAR_POLL_SECONDS=30
# Road routing provider (OSRM-compatible /route/v1/driving). Empty = straight-line x road factor estimate
ROUTING_PROVIDER_URL=
PROOF_STORAGE_DIR=./storage/private
